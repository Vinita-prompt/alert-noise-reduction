# Copy to backend/.env.production on the approved server and populate secrets
# there. Never commit the populated file.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
TZ=Asia/Kolkata
APPLICATION_TIME_ZONE=Asia/Kolkata
AUTH_DEVELOPMENT_ENABLED=false

# Permanent public URLs (no temporary tunnel hostnames).
BACKEND_DOMAIN=alerts.example.com
SLACK_EVENTS_PUBLIC_URL=https://alerts.example.com/api/slack/events
SLACK_INTERACTIONS_PUBLIC_URL=https://alerts.example.com/api/slack/interactions
ALERT_REDUCTION_WEB_URL=https://alerts.example.com
CORS_ORIGIN=https://alerts.example.com

# A managed PostgreSQL service is the production source of truth. Store the
# connection URL in the deployment secret manager, never in Git.
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional CA bundle supplied by the managed database provider.
DB_SSL_CA_FILE=
# Used only to encrypt credentials saved through the integration settings API.
INTEGRATION_ENCRYPTION_KEY=

# Slack secrets remain backend-only.
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_CHANNEL_ID=
SLACK_ALERT_VERIFICATION_CHANNEL_ID=
SLACK_HUMAN_VERIFICATION_ENABLED=true
SLACK_POLL_INTERVAL_SECONDS=30
SLACK_API_TIMEOUT_MS=10000
SLACK_CALLBACK_WORKER_INTERVAL_MS=5000
SLACK_CALLBACK_MAX_ATTEMPTS=8
SLACK_CALLBACK_BATCH_SIZE=100
SLACK_API_MAX_ATTEMPTS=5
EVIDENCE_ATTACHMENT_STORAGE_DIR=/app/data/evidence-attachments

# Jira and JSM Operations are workflow/evidence integrations. Tokens are
# backend-only and all mutation flags remain disabled.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ACC
JIRA_ALERTS_JQL=
JIRA_INCIDENTS_JQL=project = ACC ORDER BY created ASC
ATLASSIAN_EMAIL=
ATLASSIAN_CLOUD_ID=
ATLASSIAN_SITE_URL=
ATLASSIAN_JIRA_READ_TOKEN=
ATLASSIAN_OPS_READ_TOKEN=
ATLASSIAN_OPS_POLLING_ENABLED=true
ATLASSIAN_OPS_POLL_INTERVAL_SECONDS=30
ATLASSIAN_OPS_INITIAL_SYNC_DAYS=30

# AppDynamics read-only evidence.
APPDYNAMICS_CONTROLLER_URL=
APPDYNAMICS_ACCOUNT_NAME=
APPDYNAMICS_AUTH_MODE=api_client
APPDYNAMICS_USERNAME=
APPDYNAMICS_CREDENTIAL=
APPDYNAMICS_CLIENT_ID=
APPDYNAMICS_CLIENT_SECRET=
APPDYNAMICS_SYNC_INTERVAL_SECONDS=60
APPDYNAMICS_LIVE_IMPORT_MODE=false

# Grafana read-only evidence.
GRAFANA_BASE_URL=
GRAFANA_API_TOKEN=
GRAFANA_ALERT_STATE_HISTORY_UID=grafanacloud-alert-state-history
GRAFANA_ENABLED=true
GRAFANA_TIMEOUT_MS=10000

# Nagios XI REST API v1 read-only evidence.
NAGIOS_D01_BASE_URL=
NAGIOS_D01_API_KEY=
NAGIOS_D02_BASE_URL=
NAGIOS_D02_API_KEY=
NAGIOS_POLL_INTERVAL_MS=30000
NAGIOS_TIMEOUT_MS=10000

# Persistent shadow-model artifacts. This path must be a backed-up durable
# volume shared with every backend instance that performs inference.
MODEL_MODE=SHADOW
ML_PYTHON_PATH=/usr/bin/python3
ML_ARTIFACT_STORAGE_DIR=/app/data/ml-artifacts
ML_AUTOMATED_RETRAINING_ENABLED=true
ML_RETRAIN_WORKER_INTERVAL_MS=30000
ML_SCHEDULED_RETRAIN_INTERVAL_MS=21600000
ML_TRAINING_MAX_ATTEMPTS=3
ML_MINIMUM_CLASS_EXAMPLES=20

# Bounded shadow evaluation. No external action is enabled.
LIVE_EVALUATION_POLL_ENABLED=true
LIVE_EVALUATION_POLL_INTERVAL_MS=30000
LIVE_EVALUATION_BATCH_SIZE=2
OCCURRENCE_AWARE_EPISODE_GROUPING_ENABLED=false
OCCURRENCE_AWARE_EPISODE_GROUPING_ACTIVATED_AT=

# Permanent archive is intentionally explicit. Enable only for the approved
# production deployment after its PostgreSQL backup policy is in place.
EVIDENCE_COLLECTION_MODE=disabled
EVIDENCE_HISTORY_RETENTION_DAYS=60
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=3000

# Preserve read-only integration configuration from the secured deployment
# environment. Do not copy secrets into this example.
ATLASSIAN_OPS_WRITE_ENABLED=false
ATLASSIAN_JIRA_WRITE_ENABLED=false
ATLASSIAN_JSM_WRITE_ENABLED=false
