# Root-level Docker Compose inputs only. Application settings belong in
# backend/.env or backend/.env.production, which must never be committed.
# Non-secret Docker Compose selectors. Runtime secrets belong only in the
# ignored backend/.env.production file or the deployment secret manager.
BACKEND_DOMAIN=alerts.example.com
BACKEND_ENV_FILE=./backend/.env.production
BACKEND_IMAGE=alert-reduction-backend:local
FRONTEND_IMAGE=alert-reduction-frontend:local
EVIDENCE_ATTACHMENT_VOLUME_NAME=alert_reduction_attachments
ML_ARTIFACT_VOLUME_NAME=alert_reduction_ml_artifacts
